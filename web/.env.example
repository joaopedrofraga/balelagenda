# Frontend (Vite — prefixo VITE_ vai para o browser)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# --- Só no servidor (Vercel Function /api/keepalive) — NÃO use prefixo VITE_ ---
# Dashboard Supabase → Settings → API: Project URL + service_role (secret)
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
#
# Segredo do Cron (Vercel injeta Authorization: Bearer <CRON_SECRET> no job)
# Gere um valor aleatório forte, ex.: openssl rand -hex 32
# CRON_SECRET=YOUR_RANDOM_SECRET

# Secrets da Edge Function `suggest-places` (Dashboard Supabase → Edge Functions → Secrets)
# NÃO use prefixo VITE_ — essas chaves nunca vão no browser.
#
# AI_API_KEY=
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini
# PLACES_API_KEY=
# PLACES_PROVIDER=geoapify
# DEFAULT_CITY=São Paulo, Brazil
# DEFAULT_LAT=
# DEFAULT_LON=
