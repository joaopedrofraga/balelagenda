# Frontend (Vite — prefixo VITE_ vai para o browser)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# --- Só no servidor (Vercel Function /api/keepalive) — NÃO use prefixo VITE_ ---
# Dashboard Supabase → Settings → API: Project URL + service_role (secret)
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
#
# Segredo do Cron (Vercel injeta Authorization: Bearer <CRON_SECRET> no job)
# CRON_SECRET=YOUR_RANDOM_SECRET

# --- Edge Functions (Dashboard → Edge Functions → Secrets) — NUNCA no browser ---
# JWT_SECRET=  # igual ao JWT Secret do projeto (Settings → API)
# (auth: login, admin-create-user, admin-set-password, change-password)
#
# suggest-places (opcional):
# AI_API_KEY=
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini
# PLACES_API_KEY=
# PLACES_PROVIDER=geoapify
# DEFAULT_CITY=São Paulo, Brazil
# DEFAULT_LAT=
# DEFAULT_LON=
